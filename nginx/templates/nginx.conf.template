# Plantilla: la imagen oficial de Nginx la procesa con envsubst al arrancar
# (NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx => /etc/nginx/nginx.conf). Solo se reemplaza ${GATEWAY_TLS_PORT}
# (NGINX_ENVSUBST_FILTER); las variables propias de Nginx ($host, $request_id...) quedan intactas.
worker_processes 1;

events { worker_connections 1024; }

http {
  # DNS interno de Docker: devuelve la IP de cada réplica del servicio.
  # TTL corto para ver réplicas nuevas/caídas tras un --scale.
  resolver 127.0.0.11 valid=5s ipv6=off;
  default_type application/json;

  # ---------- Gateway Offloading ----------
  server_tokens off;

  # Log de acceso en JSON, con el mismo request_id que reciben los servicios.
  log_format json escape=json '{"ts":"$time_iso8601","request_id":"$request_id","remote_addr":"$remote_addr",'
    '"metodo":"$request_method","uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,'
    '"upstream_addr":"$upstream_addr","upstream_status":"$upstream_status",'
    '"request_time":$request_time,"upstream_response_time":"$upstream_response_time"}';
  access_log /var/log/nginx/access.log json;

  # Compresión de las respuestas JSON (las del catálogo pesan cientos de KB).
  gzip on;
  gzip_types application/json;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_vary on;

  # ---------- Gatekeeper: límites del pedido ----------
  client_max_body_size 64k;
  client_body_buffer_size 64k;
  large_client_header_buffers 4 8k;
  client_body_timeout 10s;
  client_header_timeout 10s;
  send_timeout 10s;

  # HTTP => HTTPS. $host no trae el puerto: se usa el publicado para TLS.
  server {
    listen 80;
    return 301 https://$host:${GATEWAY_TLS_PORT}$request_uri;
  }

  server {
    # TLS termina en el gateway; dentro de la red interna los servicios siguen hablando HTTP.
    listen 443 ssl;
    ssl_certificate     /etc/nginx/certs/tutorya.crt;
    ssl_certificate_key /etc/nginx/certs/tutorya.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:1m;

    # Cabeceras de seguridad en TODAS las respuestas (también en errores: always).
    # Se definen solo acá: las locations no usan add_header, así que las heredan.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Request-Id $request_id always;

    # Gatekeeper: lista blanca de métodos (TRACE, CONNECT, etc. => 405).
    if ($request_method !~ ^(GET|POST|PUT|PATCH|DELETE|OPTIONS)$) {
      return 405;
    }

    # Errores generados por el gateway, con el mismo formato JSON que la API.
    # (Las respuestas de error de los servicios pasan tal cual: proxy_intercept_errors está off.)
    error_page 400 494 @e400;
    error_page 404 @e404;
    error_page 405 @e405;
    error_page 408 @e408;
    error_page 413 @e413;
    error_page 414 @e414;
    error_page 502 504 @e502;

    location @e400 { return 400 '{"error":{"codigo":"PEDIDO_INVALIDO","mensaje":"Pedido inválido o cabeceras demasiado grandes"}}'; }
    location @e404 { return 404 '{"error":{"codigo":"NO_ENCONTRADO","mensaje":"Ruta no encontrada"}}'; }
    location @e405 { return 405 '{"error":{"codigo":"METODO_NO_PERMITIDO","mensaje":"Método HTTP no permitido"}}'; }
    location @e408 { return 408 '{"error":{"codigo":"TIEMPO_AGOTADO","mensaje":"El cliente tardó demasiado en enviar el pedido"}}'; }
    location @e413 { return 413 '{"error":{"codigo":"CUERPO_DEMASIADO_GRANDE","mensaje":"El body supera los 64 KB"}}'; }
    location @e414 { return 414 '{"error":{"codigo":"URI_DEMASIADO_LARGA","mensaje":"La URI es demasiado larga"}}'; }
    location @e502 { return 502 '{"error":{"codigo":"SERVICIO_NO_DISPONIBLE","mensaje":"El servicio no respondió"}}'; }

    # Cabeceras hacia los servicios: se reemplazan las que mande el cliente (no se reenvían
    # X-Instancia, X-Forwarded-For ni X-Request-Id falsificados).
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Instancia "";
    proxy_pass_header X-Instancia;
    proxy_connect_timeout 2s;
    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 3;

    # /internal/* no se expone al exterior.
    location /internal {
      return 404 '{"error":{"codigo":"NO_ENCONTRADO","mensaje":"Ruta no encontrada"}}';
    }

    # Todo lo que no sea /api/ => 404.
    location / {
      return 404 '{"error":{"codigo":"NO_ENCONTRADO","mensaje":"Ruta no encontrada"}}';
    }

    # Endpoints de salud: sin reintento en otra réplica (informan el estado de la réplica que respondió).
    location ~ ^/api/reservas/salud {
      set $upstream_reservas http://reservas:3000;
      proxy_pass $upstream_reservas;
      proxy_next_upstream off;
    }

    location ~ ^/api/salud {
      set $upstream_nucleo http://nucleo:3000;
      proxy_pass $upstream_nucleo;
      proxy_next_upstream off;
    }

    # Con variable en proxy_pass, nginx resuelve el nombre en cada request (según `valid`)
    # y reparte entre las IPs devueltas.
    location /api/reservas {
      set $upstream_reservas http://reservas:3000;
      proxy_pass $upstream_reservas;
    }

    location /api/ {
      set $upstream_nucleo http://nucleo:3000;
      proxy_pass $upstream_nucleo;
    }
  }
}
