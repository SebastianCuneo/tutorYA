# Copiar a .env para cambiar valores (opcional; docker-compose trae defaults de desarrollo)
JWT_SECRET=cambiar-este-secreto
POSTGRES_PASSWORD=tutorya
# Puertos del gateway en el host: HTTP (redirige a HTTPS) y HTTPS
GATEWAY_PORT=8080
GATEWAY_TLS_PORT=8443
PUBLIC_URL=https://localhost:8443
# Versión que informan los endpoints de salud
APP_VERSION=ut4
# Habilita /internal/fallas/* (inyección de fallas para las demos). false en producción.
FALLAS_HABILITADAS=true
