@startuml secuencia_registro
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white

actor Docente
participant Usuarios
database "db-usuarios" as DB
queue RabbitMQ
participant Docentes
participant Verificación

Docente -> Usuarios : POST /api/usuarios/registro
Usuarios -> DB : INSERT usuario + outbox(docente.registrado)\n(una sola transacción)
Usuarios --> Docente : 201 (no espera a nadie)
Usuarios -> RabbitMQ : relay publica docente.registrado
par
  RabbitMQ -> Docentes : cola docentes.eventos
  Docentes -> Docentes : crear perfil → ack
else
  RabbitMQ -> Verificación : cola verificacion.eventos
  Verificación -> Verificación : crear solicitud → ack
end
@enduml
