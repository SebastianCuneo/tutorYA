@startuml despliegue
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white

actor Cliente
node "Azure VM (Ubuntu 22.04)\nNSG: solo 8443" <<device>> as VM {
  node "Docker Engine" <<executionEnvironment>> as DE {
    rectangle "red borde" {
      node "nginx\nGatekeeper + Offloading" <<container>> as NG
    }
    rectangle "red interna (sin salida a internet)" {
      node "usuarios" <<container>> as cu
      node "docentes ×2" <<container>> as cd
      node "mensajeria" <<container>> as cm
      node "verificacion" <<container>> as cv
      node "reservas ×2" <<container>> as cr
      node "pagos" <<container>> as cp
      database "db-usuarios" <<container>> as du
      database "db-docentes" <<container>> as dd
      database "db-mensajeria" <<container>> as dm
      database "db-verificacion" <<container>> as dv
      database "db-reservas" <<container>> as dr
      database "db-pagos" <<container>> as dp
      queue "rabbitmq" <<container>> as mq
      database "redis\n(caché + config)" <<container>> as rd
    }
  }
}

Cliente --> NG : HTTPS :8443
NG --> cu
NG --> cd
NG --> cm
NG --> cv
NG --> cr
cu --> du
cd --> dd
cm --> dm
cv --> dv
cr --> dr
cp --> dp
cr --> cp : REST
cr --> cu : SOAP
cd --> rd
cu .. mq
cd .. mq
cm .. mq
cv .. mq
cr .. mq
@enduml
