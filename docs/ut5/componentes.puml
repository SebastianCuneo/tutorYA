@startuml componentes
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontSize 12
skinparam nodesep 40
skinparam ranksep 55
title TutorYa UT5 — Componentes (simplificado)

actor Cliente
component "Gateway (Nginx)" as GW
interface "API REST /api/*" as IREST
Cliente --> IREST
IREST -- GW

together {
  component "Usuarios" as U
  component "Docentes" as D
  component "Mensajería" as M
  component "Verificación" as V
  component "Reservas" as R
}
component "Pagos" as P
queue "RabbitMQ\n(exchange tutorya.eventos)" as MQ

GW --> U
GW --> D
GW --> M
GW --> V
GW --> R

interface "ConsultarEstadoEstudiante\nSOAP/WSDL" as ISOAP
interface "ConsultarDisponibilidad\nREST" as IDISP
interface "Cobrar\nREST" as ICOB
U -- ISOAP
D -- IDISP
P -up- ICOB
R ..> ISOAP : CB
R ..> IDISP : CB
R ..> ICOB : CB + Saga

U ..> MQ : publica (outbox)
V ..> MQ : publica (outbox)
R ..> MQ : publica (outbox)
MQ ..> D : suscribe
MQ ..> V : suscribe
MQ ..> M : suscribe

legend right
  CB = Circuit Breaker
  publica: docente.registrado (Usuarios),
  docente.verificado (Verificación),
  reserva.confirmada / cancelada (Reservas)
  Cada servicio tiene su propia base.
endlegend
@enduml
